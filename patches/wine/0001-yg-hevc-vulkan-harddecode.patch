+static int WINAPI yg_ff_hook_send_packet(void *avctx, const void *pkt)
+{
+    unsigned int codec_id = avctx ? *(unsigned int *)((char *)avctx + 0x18) : 0;
+    const unsigned char *data = pkt ? *(const unsigned char **)((char *)pkt + 0x18) : NULL;
+    unsigned int size = pkt ? *(unsigned int *)((char *)pkt + 0x20) : 0;
+    int ret = ((int (WINAPI *)(void *, const void *))yg_ff_send_target)(avctx, pkt);
+
+    if (yg_ff_send_count < 12)
+    {
+        WARN("yg-ffmpeg send_packet avctx %p codec %u size %u data %p ret %d.\n",
+                avctx, codec_id, size, data, ret);
+    }
+    /* yg-diag: dump the first packets (annexb, 含 VPS/SPS/PPS) 供离线解析真实 SPS/PPS */
+    if (yg_ff_send_count < 32 && data && size && size < (1u << 24))
+    {
+        static FILE *yg_stream;
+        if (!yg_stream)
+            yg_stream = fopen("/tmp/yg_stream.h265", "wb");
+        if (yg_stream)
+        {
+            fwrite(data, 1, size, yg_stream);
+            fflush(yg_stream);
+            WARN("yg-ffmpeg pkt dump %u size %u.\n", yg_ff_send_count, size);
+        }
+    }
+    /* HEVC 参数集提取(每个包都扫,码流峰值 ~80KB/s,开销可忽略) */
+    if (data && size && size < (1u << 24))
+        yg_extract_h265_params(data, size);
+    ++yg_ff_send_count;
+    return ret;
+}
