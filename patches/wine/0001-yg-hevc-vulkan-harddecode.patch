+static bool find_reference_slot(struct wined3d_decoder_vk *decoder_vk,
+        uint8_t dxva_index, unsigned int *vulkan_index)
+{
+    for (unsigned int i = 0; i < ARRAY_SIZE(decoder_vk->images); ++i)
+    {
+        if (decoder_vk->images[i].dpb_view && decoder_vk->images[i].dxva_index == dxva_index)
+        {
+            *vulkan_index = i;
+            return true;
+        }
+    }
+
+    ERR("Reference index %u was never written.\n", dxva_index);
+    return false;
+}
+
+static bool find_unused_slot(struct wined3d_decoder_vk *decoder_vk, unsigned int *vulkan_index)
+{
+    for (unsigned int i = 0; i < ARRAY_SIZE(decoder_vk->images); ++i)
+    {
+        if (!decoder_vk->images[i].used)
+        {
+            *vulkan_index = i;
+            return true;
+        }
+    }
+
+    return false;
+}
+
+/* Quiet variant used for the reference-set mapping below: returns the position
+ * of the reference with the given DXVA surface index inside the active
+ * reference slot array built in wined3d_decoder_vk_decode_h265 (same skip
+ * rules). Returns -1 when the index is not among the active references. */
+/* Claim a DPB pool slot for the picture with the given DXVA surface index.
+ * The client re-uses DXVA surfaces over time, so older slots may still carry
+ * the same index — clear them, otherwise find_reference_slot() can return a
+ * stale (older) picture as the reference and produce blocky corruption. */
+static void yg_claim_slot(struct wined3d_decoder_vk *decoder_vk, unsigned int slot_index, uint8_t dxva_index)
+{
+    for (unsigned int i = 0; i < ARRAY_SIZE(decoder_vk->images); ++i)
+    {
+        if (i != slot_index && decoder_vk->images[i].dxva_index == dxva_index)
+            decoder_vk->images[i].dxva_index = 0xff;
+    }
+    decoder_vk->images[slot_index].dxva_index = dxva_index;
+}
+
+/* Quiet variant used for the reference-set mapping in decode_h265: the DXVA
+ * arrays are padded with 0xff, which must not produce ERR spam. Returns the
+ * Vulkan DPB slot (slotIndex) holding the picture with the given DXVA surface
+ * index. */
+static bool find_reference_slot_quiet(struct wined3d_decoder_vk *decoder_vk,
+        uint8_t dxva_index, unsigned int *vulkan_index)
+{
+    for (unsigned int i = 0; i < ARRAY_SIZE(decoder_vk->images); ++i)
+    {
+        if (decoder_vk->images[i].dpb_view && decoder_vk->images[i].dxva_index == dxva_index)
+        {
+            *vulkan_index = i;
+            return true;
+        }
+    }
+
+    return false;
+}
