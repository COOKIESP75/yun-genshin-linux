+static LONG CALLBACK yg_exception_logger(EXCEPTION_POINTERS *info)
+{
+    void *frames[32];
+    CONTEXT *ctx = info->ContextRecord;
+    ULONG_PTR *stack = (ULONG_PTR *)ctx->Rsp;
+    USHORT count, i;
+    unsigned int j;
+
+    if (info->ExceptionRecord->ExceptionCode != EXCEPTION_ACCESS_VIOLATION)
+        return EXCEPTION_CONTINUE_SEARCH;
+
+    WARN("yg-veh rip %p info0 %#lx info1 %p rsp %p rbp %p.\n",
+            info->ExceptionRecord->ExceptionAddress,
+            info->ExceptionRecord->ExceptionInformation[0],
+            (void *)info->ExceptionRecord->ExceptionInformation[1],
+            (void *)ctx->Rsp, (void *)ctx->Rbp);
+
+    for (j = 0; j < 256; ++j)
+    {
+        MEMORY_BASIC_INFORMATION mbi;
+        ULONG_PTR value;
+        char path[MAX_PATH];
+        HMODULE module = NULL;
+
+        if (VirtualQuery(&stack[j], &mbi, sizeof(mbi)) != sizeof(mbi)
+                || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+            break;
+
+        value = stack[j];
+        if (value < 0x10000)
+            continue;
+        if (VirtualQuery((void *)value, &mbi, sizeof(mbi)) != sizeof(mbi)
+                || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+            continue;
+        if (!(mbi.Protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)))
+            continue;
+
+        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS
+                | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)value, &module)
+                && GetModuleFileNameA(module, path, sizeof(path)))
+        {
+            char *name = strrchr(path, '\\');
+            name = name ? name + 1 : path;
+            WARN("yg-veh stack[%u] %p %s+%#lx.\n", j, (void *)value, name,
+                    (unsigned long)((char *)value - (char *)module));
+        }
+    }
+
+    count = CaptureStackBackTrace(0, ARRAY_SIZE(frames), frames, NULL);
+    for (i = 0; i < count; ++i)
+    {
+        char path[MAX_PATH];
+        HMODULE module = NULL;
+
+        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS
+                | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)frames[i], &module)
+                && GetModuleFileNameA(module, path, sizeof(path)))
+        {
+            char *name = strrchr(path, '\\');
+            name = name ? name + 1 : path;
+            WARN("yg-veh #%u %p %s+%#lx.\n", i, frames[i], name,
+                    (unsigned long)((char *)frames[i] - (char *)module));
+        }
+    }
+    return EXCEPTION_CONTINUE_SEARCH;
+}
