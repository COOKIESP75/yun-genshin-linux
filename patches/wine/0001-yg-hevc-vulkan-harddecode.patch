+static void yg_install_ff_hooks(void)
+{
+    static BOOL done;
+    HMODULE h, ha;
+
+    if (done)
+        return;
+    done = TRUE;
+
+    h = GetModuleHandleA("avcodec-61.dll");
+    if (!h)
+        h = LoadLibraryA("avcodec-61.dll");
+    if (!h)
+    {
+        WARN("yg-ffmpeg no avcodec module.\n");
+        return;
+    }
+    ha = GetModuleHandleA("avutil-59.dll");
+    if (!ha)
+        ha = LoadLibraryA("avutil-59.dll");
+    if (!ha)
+        WARN("yg-ffmpeg no avutil module.\n");
+    yg_ff_patch(GetProcAddress(h, "avcodec_find_decoder_by_name"), yg_ff_hook_find_by_name, &yg_ff_find_by_name_target);
+    yg_ff_patch(GetProcAddress(h, "avcodec_find_decoder"), yg_ff_hook_find, &yg_ff_find_target);
+    yg_ff_patch(GetProcAddress(h, "avcodec_open2"), yg_ff_hook_open2, &yg_ff_open2_target);
+    yg_ff_patch(GetProcAddress(h, "avcodec_receive_frame"), yg_ff_hook_receive_frame, &yg_ff_receive_target);
+    yg_ff_patch(GetProcAddress(h, "avcodec_get_hw_frames_parameters"), yg_ff_hook_hwframes_parameters,
+            &yg_ff_hwparams_target);
+    yg_ff_patch(GetProcAddress(h, "avcodec_send_packet"), yg_ff_hook_send_packet, &yg_ff_send_target);
+
+#define YG_PATCH_UTIL(name, hook, target) \
+    do { if (!yg_ff_patch(GetProcAddress(ha, name), hook, target)) \
+        WARN("yg-ffmpeg patch %s failed (avutil).\n", name); } while (0)
+    if (ha)
+    {
+        YG_PATCH_UTIL("av_hwdevice_ctx_create", yg_ff_hook_hwdevice_create, &yg_ff_hwdevice_target);
+        YG_PATCH_UTIL("av_hwdevice_ctx_alloc", yg_ff_hook_hwdevice_alloc, &yg_ff_hwdevice_alloc_target);
+        YG_PATCH_UTIL("av_hwdevice_ctx_init", yg_ff_hook_hwdevice_init, &yg_ff_hwdevice_init_target);
+        YG_PATCH_UTIL("av_hwframe_ctx_alloc", yg_ff_hook_hwframe_alloc, &yg_ff_hwframe_alloc_target);
+        YG_PATCH_UTIL("av_hwframe_ctx_init", yg_ff_hook_hwframe_init, &yg_ff_hwframe_target);
+        YG_PATCH_UTIL("av_hwframe_get_buffer", yg_ff_hook_hwframe_get_buffer, &yg_ff_hwframe_getbuf_target);
+        YG_PATCH_UTIL("av_hwframe_transfer_data", yg_ff_hook_hwframe_transfer, &yg_ff_hwtransfer_target);
+    }
+#undef YG_PATCH_UTIL
+
+    WARN("yg-ffmpeg hooks installed h=%p.\n", h);
+    AddVectoredExceptionHandler(1, yg_exception_logger);
+}
