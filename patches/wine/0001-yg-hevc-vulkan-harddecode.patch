+
+    if (!ret && frame && yg_ff_receive_count++ < 8)
+    {
+        void **data = frame;
+        int *linesize = (int *)((char *)frame + 0x40);
+
+        WARN("yg-frame codec %u data %p %p %p %p %p %p %p %p\n", codec_id,
+                data[0], data[1], data[2], data[3],
+                data[4], data[5], data[6], data[7]);
+        WARN("yg-frame linesize %d %d %d %d %d %d %d %d w %d h %d fmt %d.\n",
+                linesize[0], linesize[1], linesize[2], linesize[3],
+                linesize[4], linesize[5], linesize[6], linesize[7],
+                *(int *)((char *)frame + 0x68), *(int *)((char *)frame + 0x6c), *(int *)((char *)frame + 0x74));
+    }
+    if (!ret && frame)
+        yg_ff_store_frame(frame);
+    return ret;
+}
