+/* Scan the current stack for pointers to an AVFrame-like object with the
+ * expected width/height and log its data pointers. */
+static void yg_scan_stack(unsigned int width, unsigned int height)
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    ULONG_PTR sp, limit, *slot, *cand, scan_end;
+    unsigned int i, found = 0;
+
+    __asm__ volatile("mov %%rsp, %0" : "=r"(sp));
+    limit = sp + 0x4000;
+
+    slot = (ULONG_PTR *)sp;
+    while ((ULONG_PTR)slot + sizeof(*slot) <= limit && found < 4)
+    {
+        if (VirtualQuery(slot, &mbi, sizeof(mbi)) != sizeof(mbi) || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+            break;
+        scan_end = (ULONG_PTR)mbi.BaseAddress + mbi.RegionSize;
+        if (scan_end > limit)
+            scan_end = limit;
+
+        for (; (ULONG_PTR)slot + sizeof(*slot) <= scan_end && found < 4; ++slot)
+        {
+            cand = (ULONG_PTR *)*slot;
+            if (!cand || (ULONG_PTR)cand < 0x10000)
+                continue;
+            if (VirtualQuery(cand, &mbi, sizeof(mbi)) != sizeof(mbi) || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+                continue;
