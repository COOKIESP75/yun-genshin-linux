+static BOOL yg_ff_patch(void *thunk, void *hook, void **orig)
+{
+    DWORD old_prot;
+    unsigned char *code = thunk;
+    int rel;
+
+    if (!thunk || code[0] != 0xe9)
+        return FALSE;
+    *orig = (char *)thunk + 5 + *(int *)((char *)thunk + 1);
+    if (!VirtualProtect(thunk, 5, PAGE_EXECUTE_READWRITE, &old_prot))
+        return FALSE;
+    rel = (int)((char *)hook - ((char *)thunk + 5));
+    code[1] = (unsigned char)(rel & 0xff);
+    code[2] = (unsigned char)((rel >> 8) & 0xff);
+    code[3] = (unsigned char)((rel >> 16) & 0xff);
+    code[4] = (unsigned char)((rel >> 24) & 0xff);
+    VirtualProtect(thunk, 5, old_prot, &old_prot);
+    return TRUE;
+}
