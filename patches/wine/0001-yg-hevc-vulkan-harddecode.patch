+/* The 7.2.0 cloud client's D3D11 renderer expects hardware frames, but under
+ * Wine its decoder falls back to software and passes the CPU planes as if
+ * they were a texture. Convert and upload them into the destination texture. */
+static void yg_upload_cpu_nv12(struct wined3d_device_context *wined3d_context,
+        struct wined3d_resource *dst_resource, unsigned int dst_subresource_idx,
+        const void *src_y, unsigned int src_uv_low)
+{
+    struct wined3d_sub_resource_desc desc;
+    struct yg_ff_frame_desc frame;
+    MEMORY_BASIC_INFORMATION mbi;
+    ULONG_PTR uv_addr = 0, uv_end;
+    unsigned int width, height, stride, uv_height, y, x;
+    const unsigned char *y_src = src_y, *u_src = NULL, *v_src = NULL;
+    int ls_y = 0, ls_u = 0, ls_v = 0, format = 0;
+    unsigned char *tmp;
+    BOOL have_frame, uv_ok = FALSE;
+
+    if (FAILED(wined3d_resource_get_sub_resource_desc(dst_resource, dst_subresource_idx, &desc)))
+        return;
+    if (desc.format != WINED3DFMT_NV12_PLANAR || !desc.width || !desc.height)
+        return;
+
+    width = desc.width;
+    height = desc.height;
+    stride = width;
+    uv_height = height / 2;
+
+    have_frame = yg_ff_lookup_frame(src_y, &frame)
+            && frame.width == (int)width && frame.height == (int)height && frame.y;
+    if (have_frame)
+    {
+        y_src = frame.y;
+        u_src = frame.u;
+        v_src = frame.v;
+        ls_y = frame.ls_y;
+        ls_u = frame.ls_u;
+        ls_v = frame.ls_v;
+        format = frame.format;
+    }
+    else
+    {
+        /* The client only passes the low 32 bits of the chroma pointer.
+         * Rebuild the high bits from the Y plane pointer and check that the
+         * whole plane is mapped before using it. */
+        uv_addr = ((ULONG_PTR)src_y & ~(ULONG_PTR)0xffffffff) | (src_uv_low & 0xffffffff);
+        uv_end = uv_addr + (ULONG_PTR)stride * uv_height;
+        if (VirtualQuery((void *)uv_addr, &mbi, sizeof(mbi)) == sizeof(mbi)
+                && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD))
+                && VirtualQuery((void *)(uv_end - 1), &mbi, sizeof(mbi)) == sizeof(mbi)
+                && !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD)))
+            uv_ok = TRUE;
+    }
+
+    if (ls_y < (int)width)
+        ls_y = width;
+
+    {
+        SIZE_T need = (SIZE_T)stride * height * 3 / 2;
+
+        if (yg_upload_buf_size < need)
+        {
+            unsigned char *buf = realloc(yg_upload_buf, need);
+
+            if (!buf)
+                return;
+            yg_upload_buf = buf;
+            yg_upload_buf_size = need;
+        }
+        tmp = yg_upload_buf;
+    }
+
+    if (ls_y == (int)width)
+    {
+        memcpy(tmp, y_src, (SIZE_T)width * height);
+    }
+    else
+    {
+        for (y = 0; y < height; ++y)
+            memcpy(tmp + (size_t)y * stride, y_src + (size_t)y * ls_y, width);
+    }
+
+    if (have_frame && format == 12 && u_src && v_src) /* AV_PIX_FMT_YUV420P */
+    {
+        const unsigned int pairs = width / 2;
+
+        if (ls_u < (int)pairs)
+            ls_u = pairs;
+        if (ls_v < (int)pairs)
+            ls_v = pairs;
+        for (y = 0; y < uv_height; ++y)
+        {
+            const unsigned char *u = u_src + (size_t)y * ls_u;
+            const unsigned char *v = v_src + (size_t)y * ls_v;
+            unsigned char *dst = tmp + (size_t)stride * height + (size_t)y * stride;
+
+            for (x = 0; x + 16 <= pairs; x += 16)
+            {
+                __m128i uu = _mm_loadu_si128((const __m128i *)(u + x));
+                __m128i vv = _mm_loadu_si128((const __m128i *)(v + x));
+
+                _mm_storeu_si128((__m128i *)(dst + 2 * x), _mm_unpacklo_epi8(uu, vv));
+                _mm_storeu_si128((__m128i *)(dst + 2 * x + 16), _mm_unpackhi_epi8(uu, vv));
+            }
+            for (; x < pairs; ++x)
+            {
+                dst[2 * x] = u[x];
+                dst[2 * x + 1] = v[x];
+            }
+        }
+    }
+    else if (have_frame && format == 23 && u_src) /* AV_PIX_FMT_NV12 */
+    {
+        if (ls_u < (int)width)
+            ls_u = width;
+        for (y = 0; y < uv_height; ++y)
+            memcpy(tmp + (size_t)stride * height + (size_t)y * stride, u_src + (size_t)y * ls_u, width);
+    }
+    else if (uv_ok)
+    {
+        for (y = 0; y < uv_height; ++y)
+            memcpy(tmp + (size_t)stride * height + (size_t)y * stride,
+                    (const char *)uv_addr + (size_t)y * stride, width);
+    }
+    else
+    {
+        memset(tmp + (size_t)stride * height, 128, (size_t)stride * uv_height);
+    }
+
+    {
+        static unsigned int yg_upload_log;
+
+        if (yg_upload_log++ < 3)
+            WARN("yg-upload src %p uv %p ok %d fmt %d %ux%u.\n", src_y, (void *)uv_addr, uv_ok, format, width, height);
+    }
+    wined3d_device_context_update_sub_resource(wined3d_context, dst_resource, dst_subresource_idx,
+            NULL, tmp, stride, stride * height, 0);
+}
