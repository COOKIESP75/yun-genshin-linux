+/* NV12 is a planar format: a full-resolution luma plane followed by a
+ * half-resolution interleaved chroma plane (U,V pairs on alternating rows).
+ * This is what every DXVA2 / D3D11VA hardware decoder produces, so without
+ * this conversion a decoded frame can never reach a BGRA swapchain. */
+static void convert_nv12_x8r8g8b8(const BYTE *src, BYTE *dst,
+        unsigned int pitch_in, unsigned int pitch_out, unsigned int w, unsigned int h)
+{
+    unsigned int x, y;
+    int c2, d, e, r2 = 0, g2 = 0, b2 = 0;
+    const BYTE * const chroma = src + (size_t)pitch_in * h;
+
+    /* YG diagnostic at function entry: FIXME (warn class) rather than TRACE,
+     * because WINEDEBUG=+d3d enables warn and above only, so a TRACE placed
+     * here is silently dropped and never proves the function was reached. */
