+    ps->sps_std.max_transform_hierarchy_depth_intra = (uint8_t)v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.scaling_list_enabled_flag = v;
+    if (v)
+    {
+        if (!yg_bits_get(&r, 1, &v))
+            return false;
+        ps->sps_std.flags.sps_scaling_list_data_present_flag = v;
+        if (v && !yg_parse_scaling_list(&r, &ps->sps_scaling))
+            return false;
+        ps->sps_std.pScalingLists = v ? &ps->sps_scaling : NULL;
+    }
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.amp_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.sample_adaptive_offset_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.pcm_enabled_flag = v;
+    if (v)
+    {
+        if (!yg_bits_get(&r, 4, &v))
+            return false;
+        ps->sps_std.pcm_sample_bit_depth_luma_minus1 = (uint8_t)v;
+        if (!yg_bits_get(&r, 4, &v))
+            return false;
+        ps->sps_std.pcm_sample_bit_depth_chroma_minus1 = (uint8_t)v;
+        if (!yg_bits_ue(&r, &v))
+            return false;
+        ps->sps_std.log2_min_pcm_luma_coding_block_size_minus3 = (uint8_t)v;
+        if (!yg_bits_ue(&r, &v))
+            return false;
+        ps->sps_std.log2_diff_max_min_pcm_luma_coding_block_size = (uint8_t)v;
+        if (!yg_bits_get(&r, 1, &v))
+            return false;
+        ps->sps_std.flags.pcm_loop_filter_disabled_flag = v;
+    }
+    if (!yg_bits_ue(&r, &v))
+        return false;
+    if (v >= YG_H265_MAX_SPS_RPS)
+        return false;
+    ps->sps_std.num_short_term_ref_pic_sets = (uint8_t)v;
+    for (unsigned int i = 0; i < ps->sps_std.num_short_term_ref_pic_sets; ++i)
+    {
+        if (!yg_parse_st_rps(&r, i, ps->sps_std.num_short_term_ref_pic_sets, ps))
+            return false;
+    }
+    ps->sps_std.pShortTermRefPicSet = ps->st_rps;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.long_term_ref_pics_present_flag = v;
+    if (v)
+    {
+        unsigned int lt_count;
+
+        if (!yg_bits_ue(&r, &v))
+            return false;
+        lt_count = v;
+        for (unsigned int i = 0; i < lt_count; ++i)
+        {
+            if (!yg_bits_get(&r, ps->sps_std.log2_max_pic_order_cnt_lsb_minus4 + 4, &v))
+                return false;
+            if (!yg_bits_get(&r, 1, &v))
+                return false;
+        }
+    }
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.sps_temporal_mvp_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.strong_intra_smoothing_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->sps_std.flags.vui_parameters_present_flag = v;
+    if (v && !yg_skip_vui(&r, max_sub_layers))
+        return false;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    if (v)
+        return false; /* sps_extension_present_flag — bail out */
+    return true;
+}
+
+static bool yg_parse_pps(const unsigned char *data, unsigned int len, struct yg_h265_ps_cache *ps)
+{
+    struct yg_bit_reader r = {data, len, 16};
+    uint32_t v;
+    int32_t s;
+
+    memset(&ps->pps_std, 0, sizeof(ps->pps_std));
+    if (!yg_bits_ue(&r, &v))
+        return false;
+    ps->pps_std.pps_pic_parameter_set_id = (uint8_t)v;
+    if (!yg_bits_ue(&r, &v))
+        return false;
+    ps->pps_std.pps_seq_parameter_set_id = (uint8_t)v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.dependent_slice_segments_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.output_flag_present_flag = v;
+    if (!yg_bits_get(&r, 3, &v))
+        return false;
+    ps->pps_std.num_extra_slice_header_bits = (uint8_t)v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.sign_data_hiding_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.cabac_init_present_flag = v;
+    if (!yg_bits_ue(&r, &v))
+        return false;
+    ps->pps_std.num_ref_idx_l0_default_active_minus1 = (uint8_t)v;
+    if (!yg_bits_ue(&r, &v))
+        return false;
+    ps->pps_std.num_ref_idx_l1_default_active_minus1 = (uint8_t)v;
+    if (!yg_bits_se(&r, &s))
+        return false;
+    ps->pps_std.init_qp_minus26 = (int8_t)s;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.constrained_intra_pred_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.transform_skip_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.cu_qp_delta_enabled_flag = v;
+    if (v && !yg_bits_ue(&r, &v))
+        return false;
+    ps->pps_std.diff_cu_qp_delta_depth = (uint8_t)v;
+    if (!yg_bits_se(&r, &s))
+        return false;
+    ps->pps_std.pps_cb_qp_offset = (int8_t)s;
+    if (!yg_bits_se(&r, &s))
+        return false;
+    ps->pps_std.pps_cr_qp_offset = (int8_t)s;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.pps_slice_chroma_qp_offsets_present_flag = v;
+    /* NOTE: the chroma qp offset lists belong to pps_range_extension (PPS extension),
+     * not to the base PPS — no fields follow this flag here. */
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.weighted_pred_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.weighted_bipred_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.transquant_bypass_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.tiles_enabled_flag = v;
+    if (v)
+    {
+        if (!yg_bits_ue(&r, &v))
+            return false;
+        ps->pps_std.num_tile_columns_minus1 = (uint8_t)v;
+        if (v >= STD_VIDEO_H265_CHROMA_QP_OFFSET_TILE_COLS_LIST_SIZE)
+            return false;
+        if (!yg_bits_ue(&r, &v))
+            return false;
+        ps->pps_std.num_tile_rows_minus1 = (uint8_t)v;
+        if (v >= STD_VIDEO_H265_CHROMA_QP_OFFSET_TILE_ROWS_LIST_SIZE)
+            return false;
+        if (!yg_bits_get(&r, 1, &v))
+            return false;
+        ps->pps_std.flags.uniform_spacing_flag = v;
+        if (!v)
+        {
+            for (unsigned int i = 0; i < ps->pps_std.num_tile_columns_minus1; ++i)
+                if (!yg_bits_ue(&r, &v))
+                    return false;
+                else
+                    ps->pps_std.column_width_minus1[i] = (uint16_t)v;
+            for (unsigned int i = 0; i < ps->pps_std.num_tile_rows_minus1; ++i)
+                if (!yg_bits_ue(&r, &v))
+                    return false;
+                else
+                    ps->pps_std.row_height_minus1[i] = (uint16_t)v;
+        }
+        if (!yg_bits_get(&r, 1, &v))
+            return false;
+        ps->pps_std.flags.loop_filter_across_tiles_enabled_flag = v;
+    }
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.entropy_coding_sync_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.pps_loop_filter_across_slices_enabled_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.deblocking_filter_control_present_flag = v;
+    if (v)
+    {
+        if (!yg_bits_get(&r, 1, &v))
+            return false;
+        ps->pps_std.flags.deblocking_filter_override_enabled_flag = v;
+        if (!yg_bits_get(&r, 1, &v))
+            return false;
+        ps->pps_std.flags.pps_deblocking_filter_disabled_flag = v;
+        if (!v)
+        {
+            int32_t beta, tc;
+
+            if (!yg_bits_se(&r, &beta) || !yg_bits_se(&r, &tc))
+                return false;
+            ps->pps_std.pps_beta_offset_div2 = (int8_t)beta;
+            ps->pps_std.pps_tc_offset_div2 = (int8_t)tc;
+        }
+    }
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.pps_scaling_list_data_present_flag = v;
+    if (v)
+    {
+        if (!yg_parse_scaling_list(&r, &ps->pps_scaling))
+            return false;
+        ps->pps_std.pScalingLists = &ps->pps_scaling;
+    }
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.lists_modification_present_flag = v;
+    if (!yg_bits_ue(&r, &v))
+        return false;
+    ps->pps_std.log2_parallel_merge_level_minus2 = (uint8_t)v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    ps->pps_std.flags.slice_segment_header_extension_present_flag = v;
+    if (!yg_bits_get(&r, 1, &v))
+        return false;
+    if (v)
+        return false; /* pps_extension_present_flag — bail out */
+    return true;
+}
+
+static bool yg_h265_parse_all(struct yg_h265_ps_cache *ps)
+{
+    unsigned char rbsp[2048];
+    unsigned int rbsp_len;
+
+    if (!ps->have_sps || !ps->have_pps)
+        return false;
+    rbsp_len = yg_unep(ps->sps, ps->sps_size, rbsp);
+    if (!yg_parse_sps(rbsp, rbsp_len, ps))
+    {
+        ERR("yg-h265 SPS parse failed (raw %u bytes).\n", ps->sps_size);
+        return false;
+    }
+    rbsp_len = yg_unep(ps->pps, ps->pps_size, rbsp);
+    if (!yg_parse_pps(rbsp, rbsp_len, ps))
+    {
+        ERR("yg-h265 PPS parse failed (raw %u bytes).\n", ps->pps_size);
+        return false;
+    }
+    if (ps->have_vps)
+    {
+        rbsp_len = yg_unep(ps->vps, ps->vps_size, rbsp);
+        if (!yg_parse_vps(rbsp, rbsp_len, ps))
+        {
+            /* A missing/broken VPS is tolerable: session params mainly need SPS/PPS. */
+            WARN("yg-h265 VPS parse failed, continuing without it.\n");
+            ps->vps_std.pProfileTierLevel = NULL;
+            memset(&ps->vps_std, 0, sizeof(ps->vps_std));
+        }
+    }
+    WARN("yg-h265 parsed SPS: srps %u size %ux%u dpb %u reorder %u; PPS ids %u/%u tiles %u/%u.\n",
+            ps->sps_std.num_short_term_ref_pic_sets,
+            ps->sps_std.pic_width_in_luma_samples, ps->sps_std.pic_height_in_luma_samples,
+            ps->dpb_mgr.max_dec_pic_buffering_minus1[0], ps->dpb_mgr.max_num_reorder_pics[0],
+            ps->pps_std.pps_pic_parameter_set_id, ps->pps_std.pps_seq_parameter_set_id,
+            ps->pps_std.num_tile_columns_minus1, ps->pps_std.num_tile_rows_minus1);
+    if (ps->sps_std.num_short_term_ref_pic_sets)
+        WARN("yg-h265 RPS[0]: neg %u pos %u d0 %u %u %u.\n",
+                ps->st_rps[0].num_negative_pics, ps->st_rps[0].num_positive_pics,
+                ps->st_rps[0].delta_poc_s0_minus1[0], ps->st_rps[0].delta_poc_s0_minus1[1],
+                ps->st_rps[0].delta_poc_s1_minus1[0]);
+    return true;
+}
+
+void wined3d_yg_h265_set_params(const void *vps, unsigned int vps_size,
+        const void *sps, unsigned int sps_size, const void *pps, unsigned int pps_size)
+{
+    struct yg_h265_ps_cache *ps = &yg_h265_ps;
+    bool changed = false;
+
+    if (!ps->cs_init)
+    {
+        InitializeCriticalSection(&ps->cs);
+        ps->cs_init = true;
+    }
+    EnterCriticalSection(&ps->cs);
+    if (vps && vps_size && vps_size <= sizeof(ps->vps)
+            && (vps_size != ps->vps_size || yg_hash(vps, vps_size) != ps->vps_hash))
+    {
+        memcpy(ps->vps, vps, vps_size);
+        ps->vps_size = vps_size;
+        ps->vps_hash = yg_hash(vps, vps_size);
+        ps->have_vps = true;
+        changed = true;
+    }
+    if (sps && sps_size && sps_size <= sizeof(ps->sps)
+            && (sps_size != ps->sps_size || yg_hash(sps, sps_size) != ps->sps_hash))
+    {
+        memcpy(ps->sps, sps, sps_size);
+        ps->sps_size = sps_size;
+        ps->sps_hash = yg_hash(sps, sps_size);
+        ps->have_sps = true;
+        changed = true;
+    }
+    if (pps && pps_size && pps_size <= sizeof(ps->pps)
+            && (pps_size != ps->pps_size || yg_hash(pps, pps_size) != ps->pps_hash))
+    {
+        memcpy(ps->pps, pps, pps_size);
+        ps->pps_size = pps_size;
+        ps->pps_hash = yg_hash(pps, pps_size);
+        ps->have_pps = true;
+        changed = true;
+    }
+    /* Re-parse only when the parameter sets actually changed (or the last
+     * parse failed) — this runs on every packet. */
+    if ((changed || !ps->parsed_ok) && ps->have_sps && ps->have_pps)
+        ps->parsed_ok = yg_h265_parse_all(ps);
+    LeaveCriticalSection(&ps->cs);
+}
+
+static VkVideoSessionParametersKHR create_h265_params(struct wined3d_decoder_vk *decoder_vk,
+        struct wined3d_context_vk *context_vk, bool *created)
+{
+    VkVideoDecodeH265SessionParametersCreateInfoKHR h265_create_info =
+            {.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR};
+    VkVideoDecodeH265SessionParametersAddInfoKHR h265_add_info =
+            {.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR};
+    VkVideoSessionParametersCreateInfoKHR create_info =
+            {.sType = VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR};
+    struct wined3d_device_vk *device_vk = wined3d_device_vk(decoder_vk->d.device);
+    const struct wined3d_vk_info *vk_info = &device_vk->vk_info;
+    StdVideoH265SequenceParameterSet sps = {0};
+    StdVideoH265PictureParameterSet pps = {0};
+    StdVideoH265VideoParameterSet vps = {0};
+    StdVideoH265ProfileTierLevel ptl = {0};
+    StdVideoH265DecPicBufMgr dpbm = {0};
+    StdVideoH265ScalingLists scaling = {0};
+    const DXVA_PicParams_HEVC *params;
+    const DXVA_Qmatrix_HEVC *matrices;
+    uint64_t hash;
+    bool use_real = false;
+    VkVideoSessionParametersKHR vk_params;
+    unsigned int i;
+    VkResult vr;
+
+    *created = false;
+
+    /* Prefer the real parameter sets parsed from the client bitstream. */
+    if (yg_h265_ps.cs_init)
+    {
+        EnterCriticalSection(&yg_h265_ps.cs);
+        use_real = yg_h265_ps.parsed_ok;
+        if (use_real)
+        {
+            static bool yg_real_logged;
+
+            vps = yg_h265_ps.vps_std;
+            sps = yg_h265_ps.sps_std;
+            pps = yg_h265_ps.pps_std;
+            hash = yg_h265_ps.vps_hash ^ (yg_h265_ps.sps_hash * 3) ^ (yg_h265_ps.pps_hash * 7);
+            if (!yg_real_logged++)
+                WARN("yg-h265 using real params: srps %u dpb %u size %ux%u.\n",
+                        sps.num_short_term_ref_pic_sets,
+                        sps.pDecPicBufMgr ? sps.pDecPicBufMgr->max_dec_pic_buffering_minus1[0] : 0,
+                        sps.pic_width_in_luma_samples, sps.pic_height_in_luma_samples);
+        }
+        LeaveCriticalSection(&yg_h265_ps.cs);
+        if (use_real && decoder_vk->yg_h265_params && decoder_vk->yg_h265_params_hash == hash)
+            return decoder_vk->yg_h265_params; /* unchanged — reuse */
+    }
+    if (!use_real)
+    {
+    params = wined3d_buffer_load_sysmem(decoder_vk->d.parameters, &context_vk->c);
+    matrices = wined3d_buffer_load_sysmem(decoder_vk->d.matrix, &context_vk->c);
+
+    ptl.general_profile_idc = STD_VIDEO_H265_PROFILE_IDC_MAIN;
+    ptl.general_level_idc = STD_VIDEO_H265_LEVEL_IDC_6_1;
+    ptl.flags.general_progressive_source_flag = 1;
+    ptl.flags.general_frame_only_constraint_flag = 1;
+
+    dpbm.max_dec_pic_buffering_minus1[0] = params->sps_max_dec_pic_buffering_minus1;
+
+    memcpy(scaling.ScalingList4x4, matrices->ucScalingLists0, sizeof(scaling.ScalingList4x4));
+    memcpy(scaling.ScalingList8x8, matrices->ucScalingLists1, sizeof(scaling.ScalingList8x8));
+    memcpy(scaling.ScalingList16x16, matrices->ucScalingLists2, sizeof(scaling.ScalingList16x16));
+    memcpy(scaling.ScalingList32x32, matrices->ucScalingLists3, sizeof(scaling.ScalingList32x32));
+    memcpy(scaling.ScalingListDCCoef16x16, matrices->ucScalingListDCCoefSizeID2, sizeof(scaling.ScalingListDCCoef16x16));
+    memcpy(scaling.ScalingListDCCoef32x32, matrices->ucScalingListDCCoefSizeID3, sizeof(scaling.ScalingListDCCoef32x32));
+
+    vps.flags.vps_temporal_id_nesting_flag = 1;
+    vps.flags.vps_sub_layer_ordering_info_present_flag = 1;
+    vps.vps_video_parameter_set_id = 0;
+    vps.vps_max_sub_layers_minus1 = 0;
+    vps.pProfileTierLevel = &ptl;
+    vps.pDecPicBufMgr = &dpbm;
+
+    sps.flags.sps_temporal_id_nesting_flag = 1;
+    sps.flags.separate_colour_plane_flag = params->separate_colour_plane_flag;
+    sps.flags.sps_sub_layer_ordering_info_present_flag = 1;
+    sps.flags.scaling_list_enabled_flag = params->scaling_list_enabled_flag;
+    sps.flags.sps_scaling_list_data_present_flag = params->scaling_list_enabled_flag;
+    sps.flags.amp_enabled_flag = params->amp_enabled_flag;
+    sps.flags.sample_adaptive_offset_enabled_flag = params->sample_adaptive_offset_enabled_flag;
+    sps.flags.pcm_enabled_flag = params->pcm_enabled_flag;
+    sps.flags.pcm_loop_filter_disabled_flag = params->pcm_loop_filter_disabled_flag;
+    sps.flags.sps_temporal_mvp_enabled_flag = params->sps_temporal_mvp_enabled_flag;
+    sps.flags.strong_intra_smoothing_enabled_flag = params->strong_intra_smoothing_enabled_flag;
+
+    sps.chroma_format_idc = params->chroma_format_idc;
+    sps.pic_width_in_luma_samples = (uint32_t)params->PicWidthInMinCbsY
+            << (params->log2_min_luma_coding_block_size_minus3 + 3);
+    sps.pic_height_in_luma_samples = (uint32_t)params->PicHeightInMinCbsY
+            << (params->log2_min_luma_coding_block_size_minus3 + 3);
+    sps.sps_video_parameter_set_id = 0;
+    sps.sps_max_sub_layers_minus1 = 0;
+    sps.sps_seq_parameter_set_id = 0;
+    sps.bit_depth_luma_minus8 = params->bit_depth_luma_minus8;
+    sps.bit_depth_chroma_minus8 = params->bit_depth_chroma_minus8;
+    sps.log2_max_pic_order_cnt_lsb_minus4 = params->log2_max_pic_order_cnt_lsb_minus4;
+    sps.log2_min_luma_coding_block_size_minus3 = params->log2_min_luma_coding_block_size_minus3;
+    sps.log2_diff_max_min_luma_coding_block_size = params->log2_diff_max_min_luma_coding_block_size;
+    sps.log2_min_luma_transform_block_size_minus2 = params->log2_min_transform_block_size_minus2;
+    sps.log2_diff_max_min_luma_transform_block_size = params->log2_diff_max_min_transform_block_size;
+    sps.max_transform_hierarchy_depth_inter = params->max_transform_hierarchy_depth_inter;
+    sps.max_transform_hierarchy_depth_intra = params->max_transform_hierarchy_depth_intra;
+    sps.num_short_term_ref_pic_sets = 0;
+    sps.num_long_term_ref_pics_sps = 0;
+    sps.pcm_sample_bit_depth_luma_minus1 = params->pcm_sample_bit_depth_luma_minus1;
+    sps.pcm_sample_bit_depth_chroma_minus1 = params->pcm_sample_bit_depth_chroma_minus1;
+    sps.log2_min_pcm_luma_coding_block_size_minus3 = params->log2_min_pcm_luma_coding_block_size_minus3;
+    sps.log2_diff_max_min_pcm_luma_coding_block_size = params->log2_diff_max_min_pcm_luma_coding_block_size;
+    sps.pProfileTierLevel = &ptl;
+    sps.pDecPicBufMgr = &dpbm;
+    sps.pScalingLists = params->scaling_list_enabled_flag ? &scaling : NULL;
+
+    pps.flags.dependent_slice_segments_enabled_flag = params->dependent_slice_segments_enabled_flag;
+    pps.flags.output_flag_present_flag = params->output_flag_present_flag;
