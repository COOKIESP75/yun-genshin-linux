+BOOL d3d9_yg_yuv_blit(IDirect3DDevice9 *device, IDirect3DSurface9 *src_surface,
+        IDirect3DSurface9 *dst_surface, unsigned int width, unsigned int height)
+{
+    struct d3d9_device *d3d9 = CONTAINING_RECORD(device, struct d3d9_device, IDirect3DDevice9Ex_iface);
+    struct d3d9_surface *src = CONTAINING_RECORD(src_surface, struct d3d9_surface,
+            IDirect3DSurface9_iface);
+    struct d3d9_surface *dst = CONTAINING_RECORD(dst_surface, struct d3d9_surface,
+            IDirect3DSurface9_iface);
+
+    if (!d3d9->wined3d_device)
+    {
+        WARN("yg-gpublt: no wined3d device.\n");
+        return FALSE;
+    }
+    if (!src->wined3d_texture)
+    {
+        WARN("yg-gpublt: src surface has no wined3d texture.\n");
+        return FALSE;
+    }
+    if (!dst->wined3d_texture)
+    {
+        WARN("yg-gpublt: dst surface has no wined3d texture.\n");
+        return FALSE;
+    }
+    WARN("yg-gpublt: src %p/%u dst %p/%u %ux%u\n", src->wined3d_texture,
+            src->sub_resource_idx, dst->wined3d_texture, dst->sub_resource_idx, width, height);
+
+    return wined3d_yg_yuv_blit_present(
+            (void *)wined3d_device_get_immediate_context(d3d9->wined3d_device),
+            src->wined3d_texture, src->sub_resource_idx,
+            dst->wined3d_texture, dst->sub_resource_idx, width, height);
+}
