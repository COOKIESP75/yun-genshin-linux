+static void convert_nv12_x8r8g8b8_yg(const BYTE *src, BYTE *dst,
+        unsigned int pitch_in, unsigned int pitch_out, unsigned int w,
+        unsigned int out_h, unsigned int plane_h)
+{
+    unsigned int x, y;
+    int c2, d, e, r2 = 0, g2 = 0, b2 = 0;
+    /* The chroma plane starts after the whole luma plane of the decoder
+     * surface, which is taller than the visible frame (e.g. 1088 rows for a
+     * 1920x1080 picture). Using the display height here shifts the chroma by
+     * the alignment rows and produces a wrong colour cast. */
+    const BYTE * const chroma = src + (size_t)pitch_in * plane_h;
+
+    for (y = 0; y < out_h; ++y)
+    {
+        const BYTE *src_line = src + y * pitch_in;
+        const BYTE *chroma_line = chroma + (y / 2) * pitch_in;
+        DWORD *dst_line = (DWORD *)(dst + y * pitch_out);
+
+        for (x = 0; x < w; ++x)
+        {
+            if (!(x & 1))
+            {
+                /* NV12 interleaved chroma: pixel pair k stores its U (Cb) at
+                 * byte offset 2k and its V (Cr) at 2k+1, so for a pixel at
+                 * column x the pair's samples live at chroma_line[x] and
+                 * chroma_line[x+1]. Indexing by x/2 reads the neighbouring
+                 * pair's samples for every odd pixel and desaturates the
+                 * image. */
+                d = (int) chroma_line[x] - 128;
+                e = (int) chroma_line[x + 1] - 128;
+                r2 = 409 * e + 128;
+                g2 = -100 * d - 208 * e + 128;
+                b2 = 516 * d + 128;
+
+                /* YG chroma statistics: accumulate U (first byte) and V
+                 * (second byte) so a systematic bias can be measured. */
+                if (yg_chroma_stats_on)
+                {
+                    yg_u_sum += (unsigned)chroma_line[x];
+                    yg_v_sum += (unsigned)chroma_line[x + 1];
+                    yg_chroma_n += 1;
+                }
+            }
+            c2 = 298 * ((int) src_line[x] - 16);
+            dst_line[x] = 0xff000000
+                | cliptobyte_yg((c2 + r2) >> 8) << 16
+                | cliptobyte_yg((c2 + g2) >> 8) << 8
+                | cliptobyte_yg((c2 + b2) >> 8);
+        }
+    }
+}
