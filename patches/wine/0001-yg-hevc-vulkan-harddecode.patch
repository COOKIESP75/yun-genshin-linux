+static void yg_write_file(const char *name, const void *data, size_t size)
+{
+    char path[256];
+    HANDLE f;
+    DWORD wrote = 0;
+    const BYTE *p = data;
+    ULONGLONG left = size;
+
+    snprintf(path, sizeof(path), "Z:\\tmp\\%s", name);
+    f = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE)
+        return;
+    while (left)
+    {
+        DWORD chunk = left > 0x40000000u ? 0x40000000u : (DWORD)left;
+        if (!WriteFile(f, p, chunk, &wrote, NULL) || wrote != chunk)
+            break;
+        p += chunk;
+        left -= chunk;
+    }
+    CloseHandle(f);
+    WARN("yg-export wrote %s (%u bytes)\n", path, (unsigned int)size);
+}
+
+static void yg_export_meta(double lmean, double lvar, size_t cnz, size_t cn)
+{
+    char path[256], body[512];
+    HANDLE f;
+    DWORD wrote = 0;
+    int n = snprintf(body, sizeof(body),
+            "w %u h %u pitch_in %u chroma_off %#zx chroma_bytes %u\n"
+            "mode d=chroma[x/2+1]-128 e=chroma[x/2]-128 (V first, U second)\n"
+            "luma_mean %.2f luma_var %.2f chroma_non128 %u / %u (%.2f%%)\n",
+            yg_exp_w ? yg_exp_w : 1920, yg_exp_h ? yg_exp_h : 1080,
+            yg_exp_pitch ? yg_exp_pitch : 1920,
+            (size_t)(yg_exp_pitch ? yg_exp_pitch : 1920) * (yg_exp_h ? yg_exp_h : 1080),
+            (unsigned)((yg_exp_pitch ? yg_exp_pitch : 1920) * (yg_exp_h ? yg_exp_h : 1080) / 2),
+            lmean, lvar, (unsigned)cnz, (unsigned)cn,
+            100.0 * (double)cnz / (double)(cn ? cn : 1));
+
+    snprintf(path, sizeof(path), "Z:\\tmp\\yg_meta.txt");
+    f = CreateFileA(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE)
+        return;
+    WriteFile(f, body, (DWORD)n, &wrote, NULL);
+    CloseHandle(f);
