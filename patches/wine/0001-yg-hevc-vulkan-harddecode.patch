+/* yg: extract HEVC parameter-set NALs (32=VPS 33=SPS 34=PPS) from the annexb
+ * packet and hand them to wined3d for real session parameters. */
+extern void wined3d_yg_h265_set_params(const void *vps, unsigned int vps_size,
+        const void *sps, unsigned int sps_size, const void *pps, unsigned int pps_size);
+
+static void yg_extract_h265_params(const unsigned char *data, unsigned int size)
+{
+    static unsigned char vps_buf[256], sps_buf[2048], pps_buf[512];
+    static unsigned int vps_len, sps_len, pps_len;
+    unsigned int starts[64], types[64], count = 0;
+    unsigned int pos = 0;
+
+    if (!data || size < 5)
+        return;
+    while (pos + 4 < size && count < ARRAY_SIZE(starts))
+    {
+        unsigned int sc_len = 0;
+
+        if (!data[pos] && !data[pos + 1] && data[pos + 2] == 1)
+            sc_len = 3;
+        else if (!data[pos] && !data[pos + 1] && !data[pos + 2] && data[pos + 3] == 1)
+            sc_len = 4;
+        else
+        {
+            ++pos;
+            continue;
+        }
+        starts[count] = pos + sc_len;
+        types[count] = (data[starts[count]] >> 1) & 0x3f;
+        ++count;
+        pos += sc_len;
+    }
+    for (unsigned int n = 0; n < count; ++n)
+    {
+        unsigned int end = (n + 1 < count) ? starts[n + 1] : size;
+        unsigned int len = end - starts[n];
+        unsigned char *dst;
+        unsigned int cap, *dst_len;
+
+        switch (types[n])
+        {
+            case 32: dst = vps_buf; cap = sizeof(vps_buf); dst_len = &vps_len; break;
+            case 33: dst = sps_buf; cap = sizeof(sps_buf); dst_len = &sps_len; break;
+            case 34: dst = pps_buf; cap = sizeof(pps_buf); dst_len = &pps_len; break;
+            default: continue;
+        }
+        if (len && len <= cap)
+        {
+            memcpy(dst, data + starts[n], len);
+            *dst_len = len;
+        }
+    }
+    if (sps_len && pps_len)
+        wined3d_yg_h265_set_params(vps_len ? vps_buf : NULL, vps_len,
+                sps_buf, sps_len, pps_buf, pps_len);
+}
