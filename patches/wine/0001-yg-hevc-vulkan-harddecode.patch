+        static unsigned int yg_nv12_probe_n;
+        if (yg_nv12_probe_n < 240)
+        {
+            /* Sampled output: print frames 1,10,30,60,100,150,200,230 so the
+             * transition from an empty to a populated plane is visible. */
+            static const unsigned int yg_probe_marks[] = {1, 10, 30, 60, 100, 150, 200, 230};
+            unsigned int mark = 0, mi;
+            for (mi = 0; mi < ARRAY_SIZE(yg_probe_marks); ++mi)
+                if (yg_probe_marks[mi] == yg_nv12_probe_n + 1)
+                    mark = yg_probe_marks[mi];
+            ++yg_nv12_probe_n;
+            if (mark)
+            {
+                const BYTE *yc = src, *cc = src + (size_t)pitch_in * h;
+                unsigned int ymin = 255, ymax = 0; unsigned long long ysum = 0;
+                unsigned int umin = 255, umax = 0, vmin = 255, vmax = 0;
+                unsigned long long usum = 0, vsum = 0;
+                size_t i, n = (size_t)w * h;
+                unsigned char yg_cb[16];
+
+                for (i = 0; i < n; ++i)
