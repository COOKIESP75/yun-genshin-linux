+#define YG_FF_FRAME_SLOTS 64
+static struct yg_ff_frame_desc yg_ff_frames[YG_FF_FRAME_SLOTS];
+static LONG yg_ff_frame_seq;
+
+BOOL yg_ff_lookup_frame(const void *y, struct yg_ff_frame_desc *out)
+{
+    unsigned int i;
+
+    for (i = 0; i < YG_FF_FRAME_SLOTS; ++i)
+    {
+        if (yg_ff_frames[i].y == y)
+        {
+            *out = yg_ff_frames[i];
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void yg_ff_store_frame(void *frame)
+{
+    void **data = frame;
+    int *linesize = (int *)((char *)frame + 0x40);
+    unsigned int slot = (unsigned int)InterlockedIncrement(&yg_ff_frame_seq) % YG_FF_FRAME_SLOTS;
+    struct yg_ff_frame_desc *entry = &yg_ff_frames[slot];
+
+    entry->y = data[0];
+    entry->u = data[1];
+    entry->v = data[2];
+    entry->ls_y = linesize[0];
+    entry->ls_u = linesize[1];
+    entry->ls_v = linesize[2];
+    entry->width = *(int *)((char *)frame + 0x68);
+    entry->height = *(int *)((char *)frame + 0x6c);
+    entry->format = *(int *)((char *)frame + 0x74);
+}
