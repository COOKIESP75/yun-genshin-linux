+static void wined3d_decoder_vk_decode_h265(struct wined3d_decoder_vk *decoder_vk, struct wined3d_context_vk *context_vk,
+        struct wined3d_decoder_output_view_vk *output_view_vk, VkVideoDecodeInfoKHR *decode_info,
+        const DXVA_PicParams_HEVC *params, const void *slice_control, unsigned int slice_control_size)
+{
+    VkVideoDecodeH265PictureInfoKHR vk_h265_picture = {.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PICTURE_INFO_KHR};
+    VkVideoReferenceSlotInfoKHR setup_reference_slot = {.sType = VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR};
+    VkVideoBeginCodingInfoKHR begin_info = {.sType = VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR};
+    VkVideoEndCodingInfoKHR end_info = {.sType = VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR};
+    VkVideoReferenceSlotInfoKHR reference_slots[MAX_VK_DECODE_REFERENCE_SLOTS + 1] = {0};
+    struct h265_reference_info references[MAX_VK_DECODE_REFERENCE_SLOTS] = {0};
+    const struct wined3d_vk_info *vk_info = context_vk->vk_info;
+    struct h265_reference_info setup_reference = {0};
+    StdVideoDecodeH265PictureInfo h265_picture = {0};
+    const DXVA_Slice_HEVC_Short *slices = slice_control;
+    struct wined3d_decoder_image_vk *image;
+    VkVideoSessionParametersKHR vk_params;
+    bool params_created = false;
+    unsigned int slot_count = 0;
+    unsigned int slot_index;
+    size_t slice_count;
+    uint32_t *slice_offsets;
+
+    static unsigned int yg_h265_log;
+
+    slice_count = slice_control_size / sizeof(*slices);
+    if (!(slice_offsets = malloc(slice_count * sizeof(*slice_offsets))))
+        return;
+    for (size_t i = 0; i < slice_count; ++i)
+        slice_offsets[i] = slices[i].BSNALunitDataLocation;
+
+    if (yg_h265_log++ < 5)
+        WARN("yg-h265 enter slices %zu poc %d.\n", slice_count, params->CurrPicOrderCntVal);
+
+    /* yg-diag: 前 3 帧记录关键 PicParams + slice offsets;前 4 帧把驱动实际收到的
+     * bitstream 缓冲 dump 到 /tmp/yg_bs_N.bin 供离线解析。 */
+    if (yg_h265_log <= 3)
+    {
+        WARN("yg-h265 picparams cbs %ux%u log2min %u diff %u chroma %u bpl8 %u bpc8 %u "
+                "scaling %u maxdpb %u srps %u lrps %u irap %u idr %u poc %d deltapocs %u bits %u.\n",
+                params->PicWidthInMinCbsY, params->PicHeightInMinCbsY,
+                params->log2_min_luma_coding_block_size_minus3,
+                params->log2_diff_max_min_luma_coding_block_size,
+                params->chroma_format_idc, params->bit_depth_luma_minus8,
+                params->bit_depth_chroma_minus8, (unsigned int)params->scaling_list_enabled_flag,
+                params->sps_max_dec_pic_buffering_minus1, params->num_short_term_ref_pic_sets,
+                params->num_long_term_ref_pics_sps, (unsigned int)params->IrapPicFlag,
+                (unsigned int)params->IdrPicFlag, params->CurrPicOrderCntVal,
+                params->ucNumDeltaPocsOfRefRpsIdx, params->wNumBitsForShortTermRPSInSlice);
+        WARN("yg-h265 offsets %u %u %u %u (n=%zu) curpic %u ref0 %u/%u ref1 %u/%u.\n",
+                slice_count > 0 ? slice_offsets[0] : 0, slice_count > 1 ? slice_offsets[1] : 0,
+                slice_count > 2 ? slice_offsets[2] : 0, slice_count > 3 ? slice_offsets[3] : 0,
+                slice_count, params->CurrPic.bPicEntry,
+                params->RefPicList[0].bPicEntry, params->RefPicList[0].Index7Bits,
+                params->RefPicList[1].bPicEntry, params->RefPicList[1].Index7Bits);
+    }
+    if (yg_h265_log <= 4 && decode_info->srcBufferRange)
+    {
+        const void *bs = wined3d_buffer_load_sysmem(decoder_vk->d.bitstream, &context_vk->c);
+        char path[64];
+        FILE *f;
+
+        if (bs)
+        {
+            snprintf(path, sizeof(path), "/tmp/yg_bs_%u.bin", yg_h265_log - 1);
+            if ((f = fopen(path, "wb")))
+            {
+                fwrite(bs, 1, decode_info->srcBufferRange, f);
+                fclose(f);
+            }
+            WARN("yg-h265 bitstream dump %u range %u.\n", yg_h265_log - 1, decode_info->srcBufferRange);
+        }
+    }
+
+    if (!(vk_params = create_h265_params(decoder_vk, context_vk, &params_created)))
+    {
+        WARN("yg-h265 create params failed.\n");
+        free(slice_offsets);
+        return;
+    }
+    if (yg_h265_log <= 5)
