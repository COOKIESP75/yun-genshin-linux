+static unsigned int yg_chroma_stats_on;
+/* GPU NV12 -> BGRA path: enabled by default, falls back to the CPU converter
+ * when the device-side conversion fails. */
+static int yg_gpu_blit_enabled = 1;
+static unsigned long yg_gpu_blit_ok;
+static unsigned long yg_gpu_blit_fail;
